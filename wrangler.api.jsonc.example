// Copy to wrangler.api.jsonc (gitignored) and replace every REPLACE_ME.
// Secrets, set with `wrangler secret put -c wrangler.api.jsonc <NAME>`:
//   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, IMAGE_URL_SECRET
{
  "name": "ulak-api",
  "main": "src/api/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.REPLACE_ME.example", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "ulak", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "ulak-images" }],
  "images": { "binding": "IMG" },
  "triggers": { "crons": ["17 * * * *"] },
  "unsafe": {
    "bindings": [
      { "name": "RL_SUBMIT_USER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
      { "name": "RL_SUBMIT_IP", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
      { "name": "RL_READ_USER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } },
      { "name": "RL_UPLOAD_USER", "type": "ratelimit", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
    ]
  },
  "vars": {
    "STATUS_LIST": "pending,viewed,in_progress,completed,rejected",
    "TRUST_X_FORWARDED_FOR": "false",
    "READ_IP_BACKSTOP": "false",
    "CONTROLLER_NAME": "REPLACE_ME",
    "ADMIN_URL": "https://admin.REPLACE_ME.example",
    "IMAGES_URL": "https://images.REPLACE_ME.example",
    "NOTIFIER": "telegram"
  }
}
