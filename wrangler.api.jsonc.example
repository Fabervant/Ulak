// Copy to wrangler.api.jsonc (gitignored) and replace every REPLACE_ME.
// Secrets, set with `wrangler secret put -c wrangler.api.jsonc <NAME>`:
//   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, IMAGE_URL_SECRET
// Outbound mail (optional; all five or none, checked before every deploy): add the vars
//   "MAIL_API_URL" (the mail vendor's send endpoint for your account's region) and
//   "MAIL_FROM_DOMAIN" (each app sends from <app id>@ this domain) to "vars", and the secrets
//   MAIL_API_KEY, MAIL_WEBHOOK_KEY, MAIL_HASH_SECRET. See docs/self-hosting.md.
// The second cron runs the mail outbox every 5 minutes; the first is the hourly job.
{
  "name": "ulak-api",
  "main": "src/api/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.REPLACE_ME.example", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "ulak", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "ulak-images" }],
  "images": { "binding": "IMG" },
  "triggers": { "crons": ["17 * * * *", "*/5 * * * *"] },
  "ratelimits": [
    { "name": "RL_SUBMIT_USER", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_SUBMIT_IP", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_READ_USER", "namespace_id": "2003", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_UPLOAD_USER", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "STATUS_LIST": "pending,viewed,in_progress,completed,rejected",
    "TRUST_X_FORWARDED_FOR": "false",
    "READ_IP_BACKSTOP": "false",
    "CONTROLLER_NAME": "REPLACE_ME",
    "ADMIN_URL": "https://admin.REPLACE_ME.example",
    "IMAGES_URL": "https://images.REPLACE_ME.example",
    "NOTIFIER": "telegram"
  }
}
